<?xml version="1.0" encoding="UTF-16"?>
<!--
  Import with Windows Task Scheduler after replacing __REPO_DIR__ and __ENV_FILE__.
  No credential belongs in this file.
  Trigger: user logon. Restart policy provides boot/login recovery without a paid service.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>AI Stock Intelligence hybrid worker daemon</Description></RegistrationInfo>
  <Triggers><LogonTrigger><Enabled>true</Enabled></LogonTrigger></Triggers>
  <Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RestartOnFailure><Interval>PT1M</Interval><Count>10</Count></RestartOnFailure>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>python</Command>
      <Arguments>"__REPO_DIR__\ops\autostart\start_hybrid_worker.py" --device laptop --env-file "__ENV_FILE__"</Arguments>
      <WorkingDirectory>__REPO_DIR__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
